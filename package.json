{
  "name": "app-visium-api",
  "version": "0.3.0",
  "description": "App Visium API",
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "release:patch": "git add . && standard-version -a --no-verify --release-as patch",
    "release:minor": "git add . && standard-version -a --no-verify --release-as minor",
    "release:major": "git add . && standard-version -a --no-verify --release-as major",
    "release:dry": "git add . && standard-version -a --dry-run --no-verify",
    "docker:dev": "docker image prune -f && docker-compose -f ./docker-compose.dev.yml down && docker-compose -f ./docker-compose.dev.yml up --build --remove-orphans",
    "docker:prod": "docker image prune -f && docker-compose -f ./docker-compose.prod.yml down && docker-compose -f ./docker-compose.prod.yml up --build --remove-orphans"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvaanTorres/app-visium-api.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IvaanTorres/app-visium-api/issues"
  },
  "homepage": "https://github.com/IvaanTorres/app-visium-api#readme",
  "devDependencies": {
    "husky": "^8.0.3",
    "standard-version": "^9.5.0"
  }
}
